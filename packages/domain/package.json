{
  "name": "@lanewise/domain",
  "version": "0.1.0",
  "private": true,
  "description": "LaneWise core staffing domain: forecast, Erlang C lane sizing, shrinkage, shift builder, roster + PH labor rules, team sizing, hiring waves and cost model (prototype v3 parity, DOM-001). Pure TypeScript, no I/O.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7"
  }
}
