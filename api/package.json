{
  "name": "@lanewise/api",
  "version": "0.1.0",
  "private": true,
  "description": "LaneWise JSON API (Node 20 + TypeScript) running on AWS Lambda behind Amazon API Gateway (ADR-0002, DEP-003).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run typecheck && npm run bundle",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lanewise/shared": "file:../packages/shared",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7"
  }
}
