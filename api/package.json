{
  "name": "@lanewise/api",
  "version": "0.1.0",
  "private": true,
  "description": "LaneWise JSON API (Node 20 + TypeScript) running on AWS Lambda behind Amazon API Gateway (ADR-0002, DEP-003).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run typecheck && npm run bundle",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node dist/migrate/index.mjs",
    "db:seed:demo": "node dist/seed-demo/index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1144.0",
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@lanewise/domain": "file:../packages/domain",
    "@lanewise/shared": "file:../packages/shared",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7"
  }
}
